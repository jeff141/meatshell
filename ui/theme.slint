// Central design tokens for meatshell.
//
// All colour values are reactive: change `dark` and every widget repaints
// automatically via Slint's property-binding system.
//
// Material Design 3 inspired palette:
//   • Dark surfaces use a clean, deep neutral (no muddy charcoal) so panels
//     separate by elevation (lighter = higher), not by visible borders.
//   • Borders are nearly transparent state layers — flat design relies on
//     whitespace + background contrast, not hairlines.
//   • Accent is a vivid Google-blue that reads on both schemes.

export global Theme {
    // Set by Rust on startup (system detection) and on user toggle.
    in-out property <bool> dark: true;

    // --- Palette -----------------------------------------------------------
    out property <brush> bg-root:      dark ? #121316 : #f8f9fa;
    out property <brush> bg-panel:     dark ? #1a1d23 : #ffffff;
    out property <brush> bg-panel-alt: dark ? #232730 : #f1f3f4;
    out property <brush> bg-elevated:  dark ? #2c313c : #e8eaed;
    out property <brush> bg-hover:     dark ? #ffffff14 : #0000000a;
    out property <brush> bg-active:    dark ? #ffffff24 : #00000014;

    out property <brush> border-subtle: dark ? #ffffff10 : #0000000d;
    out property <brush> border-strong: dark ? #ffffff22 : #0000001f;

    out property <brush> text-primary:   dark ? #e9eaee : #1f1f1f;
    out property <brush> text-secondary: dark ? #bdc1c6 : #5f6368;
    out property <brush> text-muted:     dark ? #9aa0a6 : #80868b;

    out property <brush> accent:         dark ? #8ab4f8 : #1a73e8;
    out property <brush> accent-hover:   dark ? #aecbfa : #1765cc;
    out property <brush> accent-pressed: dark ? #669df6 : #1557b0;

    out property <brush> success: dark ? #81c995 : #1e8e3e;
    out property <brush> warning: dark ? #fdd663 : #f9ab00;
    out property <brush> danger:  dark ? #f28b82 : #d93025;

    // Terminal uses its own background so it stays readable regardless of
    // what the shell / remote app outputs via ANSI colour codes.
    out property <brush> term-bg: dark ? #0d0e12 : #fafafa;
    out property <brush> term-fg: dark ? #d4d4d4 : #202124;

    // --- Typography --------------------------------------------------------
    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12px;
    out property <length> fs-md: 13px;
    out property <length> fs-lg: 15px;
    out property <length> fs-xl: 18px;

    // Embedded glyph-complete monospace (Cascadia Mono under a unique name, #114).
    out property <string> font-mono: "Meatshell Mono";

    // UI (sans) font for editable inputs. The embedded mono font has no CJK
    // glyphs and native TextInput doesn't glyph-fallback like Text does, so
    // typing Chinese into a bare TextInput renders tofu. Rust sets this to a
    // CJK-capable system font on startup (empty = platform default).
    in-out property <string> ui-font-family: "";

    // Terminal font — user-configurable via Interface settings, set by Rust
    // from the config on startup. cell size in terminal_view derives from these.
    in-out property <string> term-font-family: "Meatshell Mono";
    in-out property <length> term-font-size: 13px;

    // --- Geometry (Material Design 3) ----------------------------------------
    out property <length> radius-sm: 10px;   // chips, small buttons, menu items
    out property <length> radius-md: 14px;   // cards, inputs, dialogs
    out property <length> radius-lg: 18px;   // large containers, sheets
    out property <length> radius-xl: 28px;   // FAB-style, full pill buttons

    out property <length> gap-xs: 4px;
    out property <length> gap-sm: 8px;
    out property <length> gap-md: 12px;
    out property <length> gap-lg: 16px;
}
